<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mrp_production_view_move_weight_kanban_view" model="ir.ui.view">
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock_weighing.view_move_weight_kanban_view" />
        <field name="arch" type="xml">
            <field name="move_line_ids" position="after">
                <field name="is_has_production" />
            </field>
            <xpath expr="//strong/field[@name='product_id']" position="after">
                <t t-if="record.is_has_production.raw_value">
                    <i class="fa fa-fw fa-wrench" title="Manufacturing Order" />
                </t>
            </xpath>
            <button name="action_reset_weights" position="attributes">
                <attribute name="context">{'reset_all_lines': True}</attribute>
            </button>
            <button name="action_print_weight_record_label" position="after">
                <button
                    t-if="record.is_has_production.raw_value and !['done', 'cancel', 'draft'].includes(record.state.raw_value)"
                    type="object"
                    name="action_finish_weighing_workorder"
                    title="Finalizar la orden de fabricacion (solo si esta todo pesado)"
                    class="btn btn-lg btn-success ms-2"
                    confirm="Esto finalizara la operacion de pesaje/aprovisionamiento de ESTA orden de fabricacion. ¿Continuar?"
                >
                    <i class="fa fa-flag-checkered" role="image" />
                </button>
            </button>
        </field>
    </record>
</odoo>
